# LeetCode profile shown in Quick Stats → "DSA Problems".
# The username is public info (not a secret) — it only selects which profile
# to read. If unset, server/leetcode.js falls back to DEFAULT_LEETCODE_USERNAME.
LEETCODE_USERNAME=the_ojhaji9

# Optional: server-side cache TTL in milliseconds.
# Must be inside 15–60 minutes to stay polite to LeetCode. Default: 1800000 (30 min).
# LEETCODE_CACHE_TTL_MS=1800000
